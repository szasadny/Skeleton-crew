SC_REPO=owner/name
SC_GITHUB_APP_ID=123456
SC_GITHUB_APP_PRIVATE_KEY_PATH=/etc/skeleton-crew/github-app.pem
# SC_GITHUB_APP_INSTALLATION_ID=12345678
# SC_GITHUB_BOT_LOGIN=your-app-name[bot]

# Agent credentials, as SC_AGENT_CREDENTIALS__<NAME>. Set only those of the backends you use;
# a backend gets just the one for its auth mode or provider on the Agents page.
# Claude Code: CLAUDE_OAUTH_TOKEN (subscription) or ANTHROPIC_API_KEY (api_key).
# Codex: OPENAI_API_KEY (api_key) or CODEX_AUTH_JSON (subscription, ~/.codex/auth.json on one line).
# Gemini CLI: GEMINI_API_KEY (api_key) or GEMINI_OAUTH_CREDS_JSON (subscription, ~/.gemini/oauth_creds.json on one line).
# OpenCode: the key of its provider: ANTHROPIC_API_KEY, OPENAI_API_KEY, OPENROUTER_API_KEY or GEMINI_API_KEY.
# Login files contain "$", quotes or braces: wrap them in single quotes.
# SC_AGENT_CREDENTIALS__CLAUDE_OAUTH_TOKEN=
# SC_AGENT_CREDENTIALS__ANTHROPIC_API_KEY=
# SC_AGENT_CREDENTIALS__OPENAI_API_KEY=
# SC_AGENT_CREDENTIALS__CODEX_AUTH_JSON=''
# SC_AGENT_CREDENTIALS__GEMINI_API_KEY=
# SC_AGENT_CREDENTIALS__GEMINI_OAUTH_CREDS_JSON=''
# SC_AGENT_CREDENTIALS__OPENROUTER_API_KEY=

# Single quotes: the argon2 hash contains "$", which Compose would interpolate.
SC_UI_PASSWORD_HASH=''
SC_SESSION_SECRET=

SC_DATA_DIR=/var/lib/skeleton-crew
# LAN IP or hostname of the VM, used for the TLS certificate.
SC_SITE_ADDRESS=

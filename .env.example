SC_REPO=owner/name
SC_GITHUB_APP_ID=123456
SC_GITHUB_APP_PRIVATE_KEY_PATH=/etc/skeleton-crew/github-app.pem
# SC_GITHUB_APP_INSTALLATION_ID=12345678
# SC_GITHUB_BOT_LOGIN=your-app-name[bot]

# One of the two, depending on the Claude auth mode.
# SC_CLAUDE_OAUTH_TOKEN=
# SC_ANTHROPIC_API_KEY=

# Single quotes: the argon2 hash contains "$", which Compose would interpolate.
SC_UI_PASSWORD_HASH=''
SC_SESSION_SECRET=

SC_DATA_DIR=/var/lib/skeleton-crew
# LAN IP or hostname of the VM, used for the TLS certificate.
SC_SITE_ADDRESS=
